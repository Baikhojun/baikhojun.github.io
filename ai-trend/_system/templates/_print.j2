{#- 인쇄 페이지(A4 가로) 흐름 블록 매크로. build.py 가 순서대로 불러 측정·분할한다.
    분할 표 매크로 인자: (c, arg, s, e, first, last) — rows[s:e] 만 그리고, first 가 아니면 제목에 (계속) -#}

{% macro cont(first) %}{% if not first %} <span class="cont">(계속)</span>{% endif %}{% endmacro %}

{% macro h3(title, first=True, civil=False) %}<h3 class="p-h3{{ ' civil' if civil }}"><span class="bar"></span>{{ title }}{{ cont(first) }}</h3>{% endmacro %}

{# ───────── 표지 ───────── #}
{% macro cover(c) %}
{% set d = c.d %}
<div class="cv">
  <div class="cv-copy">
    <div class="cv-eyebrow">제{{ d.issue_no }}호 · {{ '신규 기준선' if d.is_baseline else '직전 발행일 ' ~ d.previous_report.report_date_kst ~ ' 대비' }}</div>
    <h1 class="cv-title">{{ d.title }}<span class="wk">{{ d.week_label }}</span></h1>
    <p class="cv-sub">{{ d.subtitle }}</p>
    <p class="cv-lead">{{ d.headline.lead }}</p>
    <div class="cv-top">
      <h2>이번 호 핵심</h2>
      <ol>{% for it in c.top[:3] %}<li>{{ it.title_ko }}</li>{% endfor %}</ol>
    </div>
  </div>
  <div class="cv-side">
    <div class="cv-art" aria-hidden="true">
      <span class="issue">ISSUE {{ "%02d"|format(d.issue_no) }}<br>{{ d.report_date_kst | replace('-', '.') }}</span>
      <i class="disc"></i><i class="ring"></i><span class="type">AI<br>TREND</span>
    </div>
    <div class="cv-basis">
      <h2>작성 기준</h2>
      <dl>
        <dt>기준일</dt><dd>{{ d.report_date_kst }} ({{ d.get('weekday_ko', '') }}) KST</dd>
        <dt>비교 기간</dt><dd>{{ c.period_start }} ~ {{ c.period_end }}{% if d.is_baseline %} (최근 30일){% endif %}</dd>
        <dt>직전 발행일</dt><dd>{{ d.previous_report.report_date_kst or '없음 — 신규 기준선' }}</dd>
        <dt>작성 목적</dt><dd>{{ d.basis.purpose }}</dd>
        <dt>데이터 기준</dt><dd>{{ d.basis.data_basis }}</dd>
        <dt>조사 규모</dt><dd>검색 {{ d.search_count }}회 · 출처 {{ c.source_count }}개 (A&nbsp;{{ c.grade_counts.A }} · B&nbsp;{{ c.grade_counts.B }} · C&nbsp;{{ c.grade_counts.C }})</dd>
        <dt>환율 기준</dt><dd>{{ fmt_num(c.fx.get('usd_krw'), 1) }}원/달러 ({{ c.fx.get('date', '') }}, {{ c.fx.get('source', '') }})</dd>
      </dl>
    </div>
  </div>
  <div class="cv-foot">
    <div class="cv-pub">Unfade<span>{{ d.report_date_kst }} 기준 발행</span></div>
    <div class="cover-tabs">
      {% for k, v in TABS.items() if k not in ('archive',) %}<span class="{{ 'civil' if k == 'civil' }}">{{ v }}</span>{% endfor %}
    </div>
  </div>
</div>
{% endmacro %}

{# ───────── 공통 머리 ───────── #}
{% macro sec_head(c, key) %}
{% set s = c.d.sections[key] %}
<div class="p-sec{{ ' civil' if key == 'civil' }}">
  <div class="no">{{ SECTION_NO[key] }}</div>
  <div class="kk">{{ SECTION_NAME[key] }}</div>
  <h2>{{ s.title }}</h2>
</div>
{% if s.get('lead') %}<p class="p-lead" style="margin-top:2mm">{{ s.lead }}</p>{% endif %}
{% endmacro %}

{% macro sub_head(c, key) %}
{% set s = c.d.sections[key] %}
<h3 class="p-h3{{ ' civil' if key.startswith('civil') }}"><span class="bar"></span>{{ s.title }}</h3>
{% if s.get('lead') %}<p class="p-lead" style="margin-top:1mm">{{ s.lead }}</p>{% endif %}
{% endmacro %}

{# ───────── 01 핵심 변화 ───────── #}
{% macro summary_stats(c, arg) %}
{% set d = c.d %}
{% set st = c.status_counts %}
<div class="p-grid" style="grid-template-columns:1.45fr 1fr;align-items:start;gap:7mm">
  <div>
    {{ h3('3분 요약') }}
    <ul class="p-summary" style="margin-top:2.5mm">
      {% for t in d.headline.three_min_summary %}
      <li><span class="s3-ico">{{ icon(d.headline.three_min_icons[loop.index0] if d.headline.three_min_icons|length > loop.index0 else 'sparkle') }}</span><span>{{ t }}</span></li>
      {% endfor %}
    </ul>
  </div>
  <div>
    {{ h3('숫자로 본 이번 호') }}
    <div class="p-stats" style="grid-template-columns:1fr 1fr;margin-top:2.5mm">
      <div class="stat"><div class="v">{{ st.new }}</div><div class="l">{{ tag('신규') }} 새로 나온 것</div></div>
      <div class="stat"><div class="v">{{ st.changed }}</div><div class="l">{{ tag('개선') }} 기능·가격·정책 변경</div></div>
      <div class="stat"><div class="v">{{ st.ended }}</div><div class="l">{{ tag('종료') }} 서비스·모델 종료</div></div>
      <div class="stat"><div class="v">{{ st.watch }}</div><div class="l">{{ tag('관찰') }} 다음 호까지 추적</div></div>
    </div>
    <p class="p-src" style="margin-top:2mm">출처 {{ c.source_count }}개 (A {{ c.grade_counts.A }} · B {{ c.grade_counts.B }} · C {{ c.grade_counts.C }}) · 검색 {{ d.search_count }}회 · 태그는 색·아이콘·글자를 함께 쓴다.</p>
  </div>
</div>
{% endmacro %}

{% macro top_list(c, arg, s, e, first, last) %}
{{ h3(c.d.sections.top.title, first) }}
<ol class="p-top split-grid">
  {% for it in c.top[s:e] %}
  <li>
    <div class="n">{{ '%02d' % (s + loop.index) }}<small>{{ IMP_LABEL.get(it.importance, '참고') }}</small></div>
    <div><h3>{{ it.title_ko }}</h3><p>{{ it.summary_ko }}</p></div>
    <div class="tg">{{ tag(it.tag) }}{% if it.get('service') %}<span class="p-src" style="margin:0">{{ it.service }}</span>{% endif %}</div>
  </li>
  {% endfor %}
</ol>
{% endmacro %}

{% macro summary3(c, arg) %}
{% set d = c.d %}
{{ h3('3분 요약 — ' ~ d.sections.top.get('kicker', '이번 기준일 꼭 알아야 할 것')) }}
<ul class="p-summary" style="margin-top:2.5mm">
  {% for t in d.headline.three_min_summary %}
  <li><span class="s3-ico">{{ icon(d.headline.three_min_icons[loop.index0] if d.headline.three_min_icons|length > loop.index0 else 'sparkle') }}</span><span>{{ t }}</span></li>
  {% endfor %}
</ul>
{% endmacro %}

{% macro stats(c, arg) %}
{% set st = c.status_counts %}
<div class="p-stats">
  <div class="stat"><div class="v">{{ st.new }}</div><div class="l">{{ tag('신규') }} 건</div></div>
  <div class="stat"><div class="v">{{ st.changed }}</div><div class="l">{{ tag('개선') }} 가격·정책 포함 변경</div></div>
  <div class="stat"><div class="v">{{ st.ended }}</div><div class="l">{{ tag('종료') }} 건</div></div>
  <div class="stat"><div class="v">{{ st.watch }}</div><div class="l">{{ tag('관찰') }} 추적 항목</div></div>
  <div class="stat"><div class="v">{{ c.source_count }}</div><div class="l">출처 (A {{ c.grade_counts.A }} · B {{ c.grade_counts.B }} · C {{ c.grade_counts.C }})</div></div>
</div>
{% endmacro %}

{% macro top_cards(c, arg, s, e, first, last) %}
{{ h3(c.d.sections.top.title, first) }}
<div class="p-grid p-g3 split-grid" style="margin-top:2.5mm">
  {% for it in c.top[s:e] %}
  <div class="p-card">
    <div class="p-row">{{ imp(it.importance) }}{{ tag(it.tag) }}</div>
    <h3 style="margin-top:1.5mm">{{ it.title_ko }}</h3>
    <p>{{ it.summary_ko }}</p>
    <p class="why"><b>왜 중요한가</b> {{ it.why_it_matters_ko }}</p>
    <div class="meta">{{ src_links(it.sources, 2, True, True) }}</div>
  </div>
  {% endfor %}
</div>
{% endmacro %}

{% macro core_table(c, arg, s, e, first, last) %}
{{ h3(c.d.sections.core.title, first) }}
<table class="p-tbl split" style="table-layout:fixed;margin-top:2mm">
  <colgroup><col style="width:10%"><col style="width:46%"><col style="width:30%"><col style="width:14%"></colgroup>
  <thead><tr><th>중요도·태그</th><th>무엇이 달라졌는가</th><th>초보자에게 왜 중요한가 · 영향 대상</th><th>근거</th></tr></thead>
  <tbody>
  {% for it in c.core[s:e] %}
  <tr>
    <td>{{ imp(it.importance) }}<div style="margin-top:1mm">{{ tag(it.tag) }}</div></td>
    <td><div class="t-title">{{ it.title_ko }}</div><div class="t-sub">{{ it.summary_ko }}</div></td>
    <td>{{ it.why_it_matters_ko }}{% if it.get('audience') %}<div class="t-sub">대상: {{ it.audience }}</div>{% endif %}</td>
    <td>{{ src_links(it.sources, 2, True, True) }}</td>
  </tr>
  {% endfor %}
  </tbody>
</table>
{% if last %}<p class="p-src">{{ '신규 기준선: 비교 기간(' ~ c.period_start ~ '~' ~ c.period_end ~ ')에 발표된 변화만 실었다.' if c.d.is_baseline else '직전 발행일 ' ~ c.d.previous_report.report_date_kst ~ ' 대비 달라진 사실만 실었다.' }}</p>{% endif %}
{% endmacro %}

{% macro timeline(c, arg) %}
{{ h3(c.d.sections.timeline.title) }}
<div class="p-fig" style="margin-top:2mm">
  {{ svg_timeline(c.timeline, c.period_start, c.period_end, 'print', 985) }}
  <p class="p-cap"><b>이 그림으로 알 수 있는 것</b>{{ c.d.sections.timeline.get('caption', '비교 기간의 사건이 언제 몰렸는지와 종류(태그 색)') }}</p>
  <p class="p-src">출처 · 각 사건의 공식 발표·보도 (전체 목록은 출처 장) · 확인일 {{ c.d.report_date_kst }}</p>
</div>
{% endmacro %}

{% macro unchanged(c, arg) %}
<div class="p-grid p-g2">
  <div class="p-card soft">
    <h3>직전 추적 항목 결과</h3>
    <p>{{ '최초 발행(신규 기준선)이므로 해당 없음. 이번 호의 추적 항목은 다음 발행에서 결과를 점검한다.' if c.d.is_baseline else '' }}</p>
  </div>
  <div class="p-card soft">
    <h3>변화가 없었던 항목</h3>
    <ul class="p-list" style="margin-top:1mm">{% for u in c.d.unchanged %}<li>{{ u }}</li>{% endfor %}</ul>
  </div>
</div>
{% endmacro %}

{% macro watch_table(c, arg, s, e, first, last) %}
{{ h3(c.d.sections.watch.title, first) }}
<table class="p-tbl split" style="table-layout:fixed;margin-top:2mm">
  <colgroup><col style="width:39%"><col style="width:11%"><col style="width:32%"><col style="width:18%"></colgroup>
  <thead><tr><th>추적 항목</th><th>구분</th><th>지켜볼 신호</th><th>근거</th></tr></thead>
  <tbody>
  {% for it in c.watch[s:e] %}
  <tr>
    <td><div class="t-title">{{ it.title_ko }}</div><div class="t-sub">{{ it.summary_ko }}</div></td>
    <td>{{ wtype(it.get('watch_type', '보도')) }}</td>
    <td>{{ it.get('signal', it.why_it_matters_ko) }}</td>
    <td>{{ src_links(it.sources, 2, True, True) }}</td>
  </tr>
  {% endfor %}
  </tbody>
</table>
{% endmacro %}

{# ───────── 02 AI 서비스 ───────── #}
{% macro services_table(c, arg, s, e, first, last) %}
{{ h3(c.d.sections.svc_table.title, first) }}
<table class="p-tbl split" style="table-layout:fixed;margin-top:2mm">
  <colgroup><col style="width:15%"><col style="width:20%"><col style="width:18%"><col style="width:19%"><col style="width:15%"><col style="width:13%"></colgroup>
  <thead><tr><th>서비스 · 주력 모델</th><th>가장 잘하는 일</th><th>초보자 추천 상황</th><th>유의할 한계</th><th>무료/유료</th><th>직전 발행 대비</th></tr></thead>
  <tbody>
  {% for r in c.d.services[s:e] %}
  <tr>
    <td><div class="t-title">{{ r.service }}</div><div class="t-sub">{{ r.vendor }} · {{ r.flagship }}</div></td>
    <td>{{ r.best_at }}</td>
    <td>{{ r.recommend_for }}</td>
    <td>{{ r.limits }}</td>
    <td>{{ r.free_paid }}</td>
    <td>{{ r.change }}</td>
  </tr>
  {% endfor %}
  </tbody>
</table>
{% if last %}<p class="p-src">출처 · 각 사 공식 발표·요금 페이지, 확인일 {{ c.d.report_date_kst }} · 근거 목록은 출처 장</p>{% endif %}
{% endmacro %}

{% macro media_table(c, arg, s, e, first, last) %}
{{ h3(c.d.sections.media.title, first) }}
<table class="p-tbl split" style="table-layout:fixed;margin-top:2mm">
  <colgroup><col style="width:8%"><col style="width:14%"><col style="width:17%"><col style="width:22%"><col style="width:22%"><col style="width:17%"></colgroup>
  <thead><tr><th>분야</th><th>서비스</th><th>최신 모델 (확인일 기준)</th><th>강점</th><th>한계·주의</th><th>요금·상태</th></tr></thead>
  <tbody>
  {% for r in c.d.media_services[s:e] %}
  <tr>
    <td>{{ r.group }}</td>
    <td><div class="t-title">{{ r.service }}</div><div class="t-sub">{{ r.vendor }}</div></td>
    <td>{{ r.latest }}</td>
    <td>{{ r.strength }}</td>
    <td>{{ r.limits }}</td>
    <td>{% if r.status == '종료' %}{{ tag('종료') }} {% endif %}{{ r.price }}</td>
  </tr>
  {% endfor %}
  </tbody>
</table>
{% endmacro %}

{% macro guide_cards(c, arg, s, e, first, last) %}
{{ h3(c.d.sections.guide.title, first) }}
<div class="p-grid p-g3 split-grid" style="margin-top:2.5mm">
  {% for g in c.d.selection_guide[s:e] %}
  <div class="p-card">
    <h3 class="p-row">{{ icon(g.icon) }} {{ g.purpose }}</h3>
    <p><b>후보</b> {{ g.candidates | join(' · ') }}</p>
    <p class="why">{{ g.why }}</p>
    {% if g.get('caution') %}<p class="meta">유의: {{ g.caution }}</p>{% endif %}
  </div>
  {% endfor %}
</div>
{% endmacro %}

{% macro perf_figs(c, arg) %}
{% set lbs = c.d.metrics.leaderboards %}
{{ h3(c.d.sections.perf.title) }}
<div class="p-grid p-g2" style="margin-top:2.5mm">
  {% for lb in lbs if lb.get('print_chart') %}
  <div class="p-fig">
    <div class="p-row" style="justify-content:space-between"><b>{{ lb.name }}</b><span class="p-src" style="margin:0">{{ lb.purpose }} · {{ lb.version }}</span></div>
    {% if lb.chart == 'dot' %}{{ svg_dotplot(lb.rows[:lb.get('chart_n', 8)], 'print', 470, lb.name) }}{% else %}{{ svg_bars(lb.bar_rows[:lb.get('chart_n', 8)], 'print', 470, lb.get('unit', ''), lb.name) }}{% endif %}
    <p class="p-cap"><b>읽는 법</b>{{ lb.easy }}</p>
    <p class="p-src">출처 · {{ lb.publisher }} ({{ lb.method }}) · 측정 {{ lb.checked_at }} · {{ short_url(lb.source_url, 40) }}</p>
  </div>
  {% endfor %}
</div>
{% endmacro %}

{% macro bench_table(c, arg, s, e, first, last) %}
{{ h3(c.d.sections.bench.title, first) }}
<table class="p-tbl split" style="table-layout:fixed;margin-top:2mm">
  <colgroup><col style="width:17%"><col style="width:11%"><col style="width:33%"><col style="width:15%"><col style="width:24%"></colgroup>
  <thead><tr><th>지표 (비유)</th><th>목적</th><th>상위권 (점수)</th><th>버전 · 측정일</th><th>해석 한계</th></tr></thead>
  <tbody>
  {% for lb in c.d.metrics.leaderboards[s:e] %}
  <tr>
    <td><div class="t-title">{{ lb.name }}</div><div class="t-sub">{{ lb.get('analogy', '') }}</div></td>
    <td>{{ lb.purpose }}</td>
    <td>{% for r in lb.rows[:3] %}{{ r.rank }}. {{ r.model }} ({{ fmt_score(r.score) }}{{ ' ±' ~ r.ci_plus if r.get('ci_plus') else '' }}){{ '' if loop.last else ' · ' }}{% endfor %}</td>
    <td>{{ lb.version }}<div class="t-sub">{{ lb.checked_at }} · {{ lb.method }}</div></td>
    <td>{{ lb.note }}</td>
  </tr>
  {% endfor %}
  </tbody>
</table>
{% if last %}<p class="p-src">개발사 자체 발표 점수는 이 표에 섞지 않았다. 점수 차가 오차 범위(±) 안이면 동률권으로 본다.</p>{% endif %}
{% endmacro %}

{% macro candidates_table(c, arg, s, e, first, last) %}
{{ h3(c.d.sections.candidates.title, first) }}
<table class="p-tbl split" style="table-layout:fixed;margin-top:2mm">
  <colgroup><col style="width:14%"><col style="width:30%"><col style="width:30%"><col style="width:26%"></colgroup>
  <thead><tr><th>목적</th><th>최상위권 (동률권 포함)</th><th>상위권</th><th>근거 지표</th></tr></thead>
  <tbody>
  {% for r in c.d.candidates[s:e] %}
  <tr><td><div class="t-title">{{ r.purpose }}</div></td><td>{{ r.top | join(' · ') }}</td><td>{{ r.upper | join(' · ') }}</td><td>{{ r.basis }}</td></tr>
  {% endfor %}
  </tbody>
</table>
{% endmacro %}

{% macro usertype_table(c, arg, s, e, first, last) %}
{{ h3(c.d.sections.usertypes.title, first) }}
<table class="p-tbl split" style="table-layout:fixed;margin-top:2mm">
  <colgroup><col style="width:16%"><col style="width:28%"><col style="width:30%"><col style="width:26%"></colgroup>
  <thead><tr><th>이용자 유형</th><th>추천 선택</th><th>이유</th><th>유의점</th></tr></thead>
  <tbody>
  {% for r in c.d.user_types[s:e] %}
  <tr><td><div class="t-title">{{ r.type }}</div></td><td>{{ r.pick }}</td><td>{{ r.why }}</td><td>{{ r.caution }}</td></tr>
  {% endfor %}
  </tbody>
</table>
{% endmacro %}

{% macro price_table(c, arg, s, e, first, last) %}
{{ h3(c.d.sections.prices.title, first) }}
<table class="p-tbl split" style="table-layout:fixed;margin-top:2mm">
  <colgroup><col style="width:15%"><col style="width:20%"><col style="width:13%"><col style="width:15%"><col style="width:11%"><col style="width:26%"></colgroup>
  <thead><tr><th>서비스</th><th>요금제</th><th>월 요금 (정가)</th><th>원화 환산</th><th>부가세</th><th>비고 · 확인일</th></tr></thead>
  <tbody>
  {% for r in c.d.metrics.prices[s:e] %}
  <tr>
    <td><div class="t-title">{{ r.service }}</div></td>
    <td>{{ r.plan }}</td>
    <td class="nowrap">{{ r.get('price_label') or ('$' ~ fmt_num(r.price, 2 if (r.price|float) % 1 else 0)) if r.get('price') is not none else (r.get('price_label') or '미확인') }}</td>
    <td>{{ r.get('krw_label') or krw(r.price, c.fx.get('usd_krw')) }}</td>
    <td>{{ vat_label(r.get('vat_included')) }}</td>
    <td>{{ r.get('note', '') }}<div class="t-sub">{{ r.checked_at }} · {{ short_url(r.source_url, 34) }}</div></td>
  </tr>
  {% endfor %}
  </tbody>
</table>
{% if last %}<p class="p-src">원화 환산 = 달러 정가 × {{ fmt_num(c.fx.get('usd_krw'), 1) }}원 ({{ c.fx.get('date') }} {{ c.fx.get('source') }}), 100원 단위 반올림. 실제 결제액은 부가세·카드 수수료·앱스토어 가격에 따라 다르다.</p>{% endif %}
{% endmacro %}

{% macro api_table(c, arg, s, e, first, last) %}
