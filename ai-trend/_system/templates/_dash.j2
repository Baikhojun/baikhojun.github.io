      <p class="mt8">{{ k.summary }}</p>
      <p class="why"><b>바탕이 된 사실</b> {{ k.basis }}</p>
      <div class="card-foot">{{ k.where }}{% if k.get('sources') %}<div class="mt8">{{ src_links(k.sources, 2) }}</div>{% endif %}</div>
    </article>
    {% endfor %}
  </div>
  <p class="src-line">커뮤니티 반응은 사실의 증명이 아니라 ‘이용자 반응’이다(등급 C). 게시글을 옮기지 않고 요약했으며 이용자 이름은 싣지 않았다.</p>
</section>
<section class="sec" id="glb-map">
  {{ sec_head(c, 'regions') }}
  <figure class="figure" style="max-width:860px">
    {{ svg_tilemap(c.all_regions, 'screen', 800, 'teal') }}
    <figcaption><p class="cap"><b>이 그림으로 알 수 있는 것</b>{{ d.sections.regions.get('caption', '이번 호에 실린 사건·사례가 어느 지역에서 나왔는지') }}</p></figcaption>
  </figure>
</section>
{% endmacro %}

{# ═════════ 아카이브 ═════════ #}
{% macro panel_archive(c, archive) %}
<section class="sec">
  <div class="sec-head"><div><div class="kicker">아카이브</div><h2 class="sec-title">지난 AI 신문은 발행 순서대로 모두 보존한다</h2>
    <p class="sec-lead">각 호는 발행 당시의 모양 그대로 남는다. 항상 최신호를 여는 고정 주소는 <a href="https://unfade.is-a.dev/ai-trend/latest/">unfade.is-a.dev/ai-trend/latest/</a> 이다.</p></div></div>
  <div class="archive-list" id="archive-list">
    {% for r in archive %}
    <a class="archive-item" href="../../{{ r.report_url }}">
      <span><span class="wk">{{ r.week_label }}</span><span class="dt"> · 제{{ r.issue_no }}호 · {{ r.published_at_kst }}{{ ' · 정정 전' if r.status == 'superseded' else '' }}</span></span>
      <ul>{% for s in r.summary[:3] %}<li>{{ s }}</li>{% endfor %}</ul>
      <span class="btn">열기</span>
    </a>
    {% endfor %}
  </div>
</section>
{% endmacro %}

{# ═════════ 출처 ═════════ #}
{% macro panel_sources(c) %}
{% set d = c.d %}
<section class="sec">
  {{ sec_head(c, 'sources', None, '06') }}
  {{ toc([('src-dl', '내려받기'), ('src-method', '조사 방법·한계'), ('src-gloss', '용어집'), ('src-all', '전체 출처')]) }}
</section>
<section class="sec" id="src-dl">
  <h3 class="sub-title">이번 호 파일 내려받기</h3>
  <div class="dl-list">
    <a class="dl-item" href="report.pdf" download="{{ d.download_prefix }}.pdf"><span class="ext">PDF</span><span><span class="nm">인쇄용 보고서</span><span class="fn">{{ d.download_prefix }}.pdf</span></span></a>
    <a class="dl-item" href="report.pptx" download="{{ d.download_prefix }}.pptx"><span class="ext">PPT</span><span><span class="nm">발표용 슬라이드</span><span class="fn">{{ d.download_prefix }}.pptx</span></span></a>
    <a class="dl-item" href="research.md" download="{{ d.download_prefix }}_조사근거.md"><span class="ext">MD</span><span><span class="nm">조사 근거 기록</span><span class="fn">{{ d.download_prefix }}_조사근거.md</span></span></a>
    <a class="dl-item" href="data.json" download="{{ d.download_prefix }}_데이터.json"><span class="ext">JSON</span><span><span class="nm">데이터 원본</span><span class="fn">{{ d.download_prefix }}_데이터.json</span></span></a>
  </div>
</section>
<section class="sec" id="src-method">
  {% set m = d.methodology %}
  <div class="grid g2" style="align-items:start">
    <div class="card">
      <h3 class="row">{{ icon('search') }} 조사 방법</h3>
      <dl class="kv mt16">
        <dt class="muted">기준일</dt><dd>{{ d.report_date_kst }} KST (코드로 계산)</dd>
        <dt class="muted">비교 기간</dt><dd>{{ c.period_start }} ~ {{ c.period_end }}</dd>
        <dt class="muted">검색 횟수</dt><dd>{{ d.search_count }}회 (원문 열람 {{ m.get('fetch_count', '—') }}회)</dd>
        <dt class="muted">출처</dt><dd>{{ c.source_count }}개 · {{ grade('A') }} {{ c.grade_counts.A }} · {{ grade('B') }} {{ c.grade_counts.B }} · {{ grade('C') }} {{ c.grade_counts.C }}</dd>
        {% for k in m.criteria %}<dt class="muted">{{ k.k }}</dt><dd>{{ k.v }}</dd>{% endfor %}
      </dl>
    </div>
    <div class="card">
      <h3 class="row">{{ icon('alert') }} 조사 한계 · 추가 확인 필요</h3>
      <ul class="mt16">{% for x in d.limitations %}<li>{{ x }}</li>{% endfor %}</ul>
    </div>
  </div>
</section>
<section class="sec" id="src-gloss">
  <h3 class="sub-title">용어집 — 처음 보는 말을 쉬운 말로</h3>
  <div class="glossary">
    {% for g in d.glossary %}<div class="card"><h3>{{ g.term }}</h3><p>{{ g.easy_ko }}</p><p class="an">비유: {{ g.analogy }}</p></div>{% endfor %}
  </div>
</section>
<section class="sec" id="src-all">
  <h3 class="sub-title">전체 출처 {{ c.source_count }}개 (등급순)</h3>
  <p class="sub-lead">{{ grade('A') }} 공식 발표·정부·원 논문·독립 벤치마크 &nbsp; {{ grade('B') }} 신뢰할 수 있는 전문 매체 &nbsp; {{ grade('C') }} 커뮤니티·관찰(반응 항목에만 사용). 확인일은 모두 {{ d.report_date_kst }}.</p>
  <div class="tbl-wrap">
    <table class="tbl sources-tbl">
      <thead><tr><th style="width:5%">#</th><th style="width:7%">등급</th><th style="width:48%">출처 (발행처)</th><th style="width:12%">게시일</th><th style="width:28%">주소</th></tr></thead>
      <tbody>
      {% for x in c.sources %}
      <tr><td>{{ loop.index }}</td><td>{{ grade(x.grade) }}</td><td>{{ x.get('title', '') }}<div class="t-sub">{{ x.get('publisher', '') }}</div></td><td class="nowrap">{{ x.get('published_at') or '—' }}</td>
        <td><a href="{{ x.url }}" target="_blank" rel="noopener">{{ short_url(x.url, 44) }}</a></td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endmacro %}
