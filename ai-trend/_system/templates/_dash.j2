</section>

<section class="sec" id="svc-api">
  {{ sec_head(c, 'api') }}
  <div class="tbl-wrap">
    <table class="tbl">
      <thead><tr><th style="width:13%">개발사</th><th style="width:22%">모델</th><th style="width:14%">입력 (100만 토큰)</th><th style="width:14%">출력 (100만 토큰)</th><th style="width:37%">비고 · 확인</th></tr></thead>
      <tbody>
      {% for r in d.metrics.api_prices %}
      <tr><td>{{ r.vendor }}</td><td><div class="t-title">{{ r.model }}</div></td><td class="nowrap">${{ fmt_num(r.input, 2) }}</td><td class="nowrap">${{ fmt_num(r.output, 2) }}</td>
        <td>{{ r.get('note', '') }}<div class="t-sub">{{ r.checked_at }} · <a href="{{ r.source_url }}" target="_blank" rel="noopener">{{ short_url(r.source_url, 40) }}</a></div></td></tr>
      {% endfor %}
