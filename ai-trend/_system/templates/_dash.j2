{# ═════════ 03 가능해진 일 ═════════ #}
{% macro panel_capabilities(c) %}
{% set d = c.d %}
<section class="sec">
  {{ sec_head(c, 'capabilities', None, '03') }}
  {{ toc([('cap-flow', '8개 영역 흐름'), ('cap-matrix', '가능 수준 매트릭스'), ('cap-files', '파일 형식 지원'), ('cap-reality', '현실적인 사용 범위'), ('cap-daily', '일상과 업무')]) }}
</section>

<section class="sec" id="cap-flow">
  {{ sec_head(c, 'cap_flow') }}
  <div class="grid g2">
    {% for a in d.capability_areas %}
    <article class="card area-card" id="area-{{ a.key }}">
      <div class="row-between"><h3><span class="area-ico">{{ icon(a.icon) }}</span>{{ a.area }}</h3></div>
      <p class="mt8" style="font-weight:650">{{ a.title }}</p>
      <div class="flow">
        <div class="st"><span class="k">입력</span>{{ a.input }}</div>
        <div class="st ai"><span class="k">AI 작업</span>{{ a.ai }}</div>
        <div class="st human"><span class="k">사람이 확인할 일</span>{{ a.human }}</div>
        <div class="st"><span class="k">결과물</span>{{ a.output }}</div>
      </div>
      {% if a.get('level_note') %}<div class="card-foot">{{ a.level_note }}</div>{% endif %}
    </article>
    {% endfor %}
  </div>
</section>

<section class="sec" id="cap-matrix">
  {{ sec_head(c, 'matrix') }}
  <div class="tbl-wrap">
    <table class="tbl tbl-matrix">
      <thead><tr><th style="width:22%">시나리오</th>{% for sv in d.matrix_order.services %}<th>{{ sv }}</th>{% endfor %}</tr></thead>
      <tbody>
      {% for sc in d.matrix_order.scenarios %}
      <tr><td><div class="t-title">{{ sc }}</div></td>
        {% for sv in d.matrix_order.services %}{% set cell = c.matrix.get(sc ~ '|' ~ sv) %}
        <td>{% if cell %}{% if cell.get('source_url') %}<a href="{{ cell.source_url }}" target="_blank" rel="noopener" style="text-decoration:none" title="판정 근거 열기">{{ lvl(cell.level) }}</a>{% else %}{{ lvl(cell.level) }}{% endif %}{% if cell.get('plan') %}<span class="note">{{ cell.plan }}</span>{% endif %}{% else %}{{ lvl('?') }}{% endif %}</td>
        {% endfor %}
      </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  <p class="src-line">기호 = {{ lvl('●') }} 공식 기본 기능 · {{ lvl('◐') }} 코드 실행 우회·연동·상위 요금제·베타 · {{ lvl('○') }} 현재 불가 · {{ lvl('?') }} 공식 근거를 찾지 못함. 기호를 누르면 판정 근거(공식 문서)가 열린다. 실측하지 않은 칸은 공식 문서 기준이다.</p>
</section>

<section class="sec" id="cap-files">
  {{ sec_head(c, 'files') }}
  <div class="tbl-wrap">
    <table class="tbl tbl-matrix">
      <thead><tr><th style="width:15%">형식</th><th style="width:13%">서비스</th><th>읽기</th><th>변환</th><th>생성</th><th>편집</th><th style="width:28%;text-align:left">방법 · 비고</th></tr></thead>
      <tbody>
      {% for r in d.metrics.file_support %}
      <tr><td><div class="t-title">{{ r.format }}</div></td><td>{{ r.service }}</td><td>{{ lvl(r.read) }}</td><td>{{ lvl(r.convert) }}</td><td>{{ lvl(r.create) }}</td><td>{{ lvl(r.edit) }}</td>
        <td style="text-align:left">{{ r.method }}{% if r.get('note') %}<span class="note">{{ r.note }}</span>{% endif %}</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>

<section class="sec" id="cap-reality">
  {% set r = d.realistic_scope %}
  <h2 class="sec-title" style="font-size:26px">{{ r.title }}</h2>
  <div class="reality mt24">
    <div class="can"><h4>{{ icon('check') }} AI에게 맡겨 볼 수 있는 일</h4><ul>{% for x in r.can %}<li>{{ x }}</li>{% endfor %}</ul></div>
    <div class="must"><h4>{{ icon('shield') }} 사람이 판단·책임져야 하는 일</h4><ul>{% for x in r.must %}<li>{{ x }}</li>{% endfor %}</ul></div>
  </div>
  {% if r.get('note') %}<p class="src-line">{{ r.note }}</p>{% endif %}
</section>

<section class="sec" id="cap-daily">
  {{ sec_head(c, 'daily') }}
  <div class="grid g3">
    {% for sc in d.daily.scenes %}
    <article class="card">
      <h3 class="row"><span class="area-ico" style="width:36px;height:36px;border-radius:10px;display:grid;place-items:center;background:var(--bg-elev-2);color:var(--teal)">{{ icon(sc.icon) }}</span>{{ sc.title }}</h3>
      <div class="flow flow3">
        <div class="st"><span class="k">입력</span>{{ sc.input }}</div>
        <div class="st ai"><span class="k">AI가 하는 일</span>{{ sc.ai }}</div>
        <div class="st"><span class="k">결과</span>{{ sc.result }}</div>
      </div>
      {% if sc.get('sources') %}<div class="card-foot">{{ src_links(sc.sources, 2) }}</div>{% endif %}
    </article>
    {% endfor %}
  </div>
  <div class="grid g3 mt24">
    <div class="card"><h3 class="row">{{ icon('agent') }} AI가 상당 부분 대신하는 일</h3><ul class="mt8">{% for x in d.daily.replace %}<li>{{ x }}</li>{% endfor %}</ul></div>
    <div class="card"><h3 class="row">{{ icon('users') }} 사람이 최종 판단해야 하는 일</h3><ul class="mt8">{% for x in d.daily.human %}<li>{{ x }}</li>{% endfor %}</ul></div>
    {% set k = d.daily.case_card %}
    <div class="card card-2"><h3 class="row">{{ icon('building') }} 기업 사례 한 장 — {{ k.company }}</h3><p class="mt8">{{ k.task }}</p><p class="why"><b>확인된 효과</b> {{ k.effect }}</p><div class="card-foot">{{ k.country }} · {{ src_links(k.sources, 2) }}</div></div>
  </div>
  {% set t = d.daily.try_it %}
  <div class="card mt24" style="border-color:rgba(46,196,182,.5)">
    <div class="kicker">{{ icon('sparkle') }}한 번 해 보기</div>
    <h3>{{ t.title }}</h3>
    <p class="muted mt8">{{ t.service }}</p>
    <ol class="mt16">{% for x in t.steps %}<li>{{ x }}</li>{% endfor %}</ol>
    <div class="easy"><b>예시 지시문</b>{{ t.prompt }}</div>
    {% if t.get('note') %}<p class="src-line">{{ t.note }}</p>{% endif %}
  </div>
</section>
{% endmacro %}

{# ═════════ 04 토목설계 AI 특집 ═════════ #}
{% macro civil_cards(c, sub) %}
{% set lst = c.civil_by_sub.get(sub, []) %}
<div class="grid g3">
  {% for it in lst %}
  <article class="card card-civil" id="item-{{ it.id }}">
    <div class="row">{{ mat(it.maturity) }}{{ tag(it.tag) }}</div>
    <h3 class="mt8">{{ it.title_ko }}</h3>
    <p class="mt8">{{ it.summary_ko }}</p>
    <div class="case-meta">
      <span><b>국가</b> {{ it.get('country', '') }}</span><span><b>기관</b> {{ it.get('org', '') }}</span>
      {% if it.get('project') %}<span><b>프로젝트</b> {{ it.project }}</span>{% endif %}
      {% if it.get('effect') %}<span><b>효과</b> {{ it.effect }}</span>{% endif %}
    </div>
    <div class="card-foot">{{ src_links(it.sources, 3) }}</div>
  </article>
  {% else %}
  <p class="note-box">{{ '비교 기간에 확인된 사례 없음 — 직전 보고서 대비 주요 확인 변화 없음' }}</p>
  {% endfor %}
</div>
{% endmacro %}

{% macro panel_civil(c) %}
{% set d = c.d %}
{% set cv = d.civil %}
<div class="civil-banner">
  <div>
    <div class="kicker">{{ icon('bridge') }}04 · 토목설계 AI 특집</div>
    <h2>{{ cv.banner.title }}</h2>
    <p>{{ cv.banner.lead }}</p>
  </div>
  <div class="civil-key">
    {% for k in cv.key_stats %}<div><b>{{ k.v }}</b><span>{{ k.label }}</span></div>{% endfor %}
  </div>
</div>
{{ toc([('civ-cad', 'CAD·도면 AI'), ('civ-bim', 'BIM·IFC·디지털트윈'), ('civ-gis', 'GIS·측량'), ('civ-infra', '인프라·안전·유지관리'), ('civ-prod', '설계·시공 생산성'), ('civ-news', '업계 신기술 뉴스')]) }}

<section class="sec sec-civil" id="civ-cad">
  {{ sec_head(c, 'civil_cad') }}
  {% set f = cv.cad_flow %}
  <div class="flow flow-civil">
    <div class="st"><span class="k">① 파일 입력</span>{{ f.input }}</div>
    <div class="st ai"><span class="k">② AI 처리</span>{{ f.ai }}</div>
    <div class="st human"><span class="k">③ 설계자 검토</span>{{ f.human }}</div>
    <div class="st"><span class="k">④ 산출물</span>{{ f.output }}</div>
  </div>
  {% set L = cv.ladder %}
  <h3 class="sub-title">{{ L.title }}</h3>
  <div class="ladder" style="--cols:{{ L.columns|length }}">
    <div class="step head"><span>단계</span><span>확인 내용</span>{% for col in L.columns %}<span class="cell">{{ col }}</span>{% endfor %}</div>
    {% for st in L.steps %}
    <div class="step"><span class="no">{{ st.no }}</span><span class="q">{{ st.q }}{% if st.get('sub') %}<small>{{ st.sub }}</small>{% endif %}</span>
      {% for cell in st.cells %}<span class="cell">{{ lvl(cell.lv) }}{% if cell.get('note') %}<span class="note">{{ cell.note }}</span>{% endif %}</span>{% endfor %}</div>
    {% endfor %}
  </div>
  {% if L.get('source_note') %}<p class="src-line">{{ L.source_note }}</p>{% endif %}
  {{ sub(c, 'civil_cad_news') }}
  {{ civil_cards(c, 'CAD·도면') }}
  {{ sub(c, 'civil_files') }}
  <div class="tbl-wrap">
    <table class="tbl tbl-matrix">
      <thead><tr><th style="width:18%">플랫폼 · 기능</th><th>형식</th><th>읽기</th><th>변환</th><th>생성</th><th>편집</th><th style="width:30%;text-align:left">방법 · 비고</th></tr></thead>
      <tbody>
      {% for r in cv.platform_files %}
      <tr><td><div class="t-title">{{ r.platform }}</div><div class="t-sub">{{ r.product }}</div></td><td>{{ r.format }}</td><td>{{ lvl(r.read) }}</td><td>{{ lvl(r.convert) }}</td><td>{{ lvl(r.create) }}</td><td>{{ lvl(r.edit) }}</td>
        <td style="text-align:left">{{ r.method }}{% if r.get('note') %}<span class="note">{{ r.note }}</span>{% endif %}{% if r.get('source_url') %}<span class="note"><a href="{{ r.source_url }}" target="_blank" rel="noopener">근거</a></span>{% endif %}</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>

<section class="sec sec-civil" id="civ-bim">
  {{ sec_head(c, 'civil_bim') }}
  <figure class="figure">
    {{ svg_lifecycle(cv.lifecycle, 'screen', 1400) }}
    <figcaption><p class="cap"><b>이 그림으로 알 수 있는 것</b>{{ d.sections.civil_bim.get('caption', '') }}</p></figcaption>
  </figure>
  {{ sub(c, 'civil_bim_news') }}
  {{ civil_cards(c, 'BIM·IFC·디지털트윈') }}
</section>

<section class="sec sec-civil" id="civ-gis">
  {{ sec_head(c, 'civil_gis') }}
  <div class="grid g-civgis">
    {{ civil_cards(c, 'GIS·측량') }}
    <figure class="figure">
      <h3 class="card-title">토목 특집 사례의 국가 분포</h3>
      <div class="mt16">{{ svg_tilemap(c.civil_regions, 'screen', 520, 'violet') }}</div>
      <figcaption><p class="cap"><b>이 그림으로 알 수 있는 것</b>이번 호 토목 특집 사례가 어느 나라에서 나왔는지(숫자 = 사례 수)</p></figcaption>
    </figure>
  </div>
</section>

<section class="sec sec-civil" id="civ-infra">
  {{ sec_head(c, 'civil_infra') }}
  {% set M = cv.infra_matrix %}
  <h3 class="sub-title">{{ d.sections.civil_matrix.title }}</h3>
  <div class="tbl-wrap">
    <table class="tbl tbl-matrix">
      <thead><tr><th style="width:12%">분야</th>{% for col in M.cols %}<th>{{ col }}</th>{% endfor %}</tr></thead>
      <tbody>
      {% for row in M.rows %}
      <tr><td><div class="t-title">{{ row }}</div></td>{% for col in M.cols %}{% set v = M.cells.get(row ~ '|' ~ col) %}<td>{% if v %}{% for x in v %}<span class="note" style="color:var(--text)">{{ x }}</span>{% endfor %}{% else %}<span class="note">—</span>{% endif %}</td>{% endfor %}</tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% if M.get('note') %}<p class="src-line">{{ M.note }}</p>{% endif %}
  <div class="mt32">{{ civil_cards(c, '인프라·안전·유지관리') }}</div>
</section>

<section class="sec sec-civil" id="civ-prod">
  {{ sec_head(c, 'civil_prod') }}
  <div class="grid g2">
    {% for v in cv.compare %}
    <article class="card card-civil">
      <div class="row-between"><h3>{{ v.task }}</h3>{{ mat(v.maturity) }}</div>
      <div class="vs mt16"><div class="old"><span class="k">기존 방식</span>{{ v.old }}</div><div class="arrow" aria-hidden="true">→</div><div class="new"><span class="k">AI 보조 방식</span>{{ v.new }}</div></div>
      {% if v.get('sources') %}<div class="card-foot">{{ src_links(v.sources, 2) }}</div>{% endif %}
    </article>
    {% endfor %}
  </div>
  {{ sub(c, 'civil_prod_news') }}
  {{ civil_cards(c, '설계·시공 생산성') }}
</section>

<section class="sec sec-civil" id="civ-news">
  {{ sec_head(c, 'civil_news') }}
  {{ civil_cards(c, '업계 신기술') }}
  <div class="note-box mt24">성숙도 태그: {{ mat('실무 적용') }} 실제 프로젝트·운영에 쓰임 · {{ mat('시험·시범') }} 파일럿·실증 단계 · {{ mat('검증 부족') }} 발표·주장만 있고 독립 검증 부족. 모든 사례는 엔지니어의 검토·책임을 전제로 한다.</div>
</section>
{% endmacro %}

{# ═════════ 05 글로벌 사례 ═════════ #}
{% macro panel_global(c) %}
{% set d = c.d %}
<section class="sec">
  {{ sec_head(c, 'global', None, '05') }}
  {{ toc([('glb-radar', '트렌드 레이더'), ('glb-cases', '기업 도입 사례'), ('glb-community', '커뮤니티 반응'), ('glb-map', '지역 분포')]) }}
