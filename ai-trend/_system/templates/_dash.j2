{#- 대시보드(화면) 패널 매크로. 인쇄 블록(_print.j2)과 같은 data.json 값을 쓴다. -#}

{% macro sec_head(c, key, anchor=None, no=None) %}
{% set s = c.d.sections[key] %}
<div class="sec-head" {% if anchor %}id="{{ anchor }}"{% endif %}>
  <div>
    <div class="kicker">{% if no %}<span class="k-num">{{ no }}</span>{% endif %}{{ s.get('kicker', '') }}</div>
    <h2 class="sec-title">{{ s.title }}</h2>
    {% if s.get('lead') %}<p class="sec-lead">{{ s.lead }}</p>{% endif %}
  </div>
</div>
{% endmacro %}

{% macro sub(c, key, anchor=None) %}
{% set s = c.d.sections[key] %}
<h3 class="sub-title" {% if anchor %}id="{{ anchor }}"{% endif %}>{{ s.title }}</h3>
{% if s.get('lead') %}<p class="sub-lead">{{ s.lead }}</p>{% endif %}
{% endmacro %}

{% macro toc(links) %}
<nav class="panel-toc" aria-label="이 탭의 목차"><span>목차</span>{% for a, t in links %}<a href="#{{ a }}">{{ t }}</a>{% endfor %}</nav>
{% endmacro %}

{# ═════════ 01 핵심 변화 ═════════ #}
{% macro panel_changes(c) %}
{% set d = c.d %}
{#- A형: 매거진 표지 히어로 #}
<section class="cover-hero" aria-labelledby="hero-title">
  <div class="cover-copy">
    <div class="eyebrow">AI 트렌드 브리핑 · 제{{ d.issue_no }}호</div>
    <h1 class="cover-title" id="hero-title">{{ c.og_headline }}<span class="wk">{{ d.title }} | {{ d.week_label }}</span></h1>
    <p class="cover-deck">{{ d.subtitle }}</p>
    <p class="cover-summary">{{ d.headline.lead }}</p>
    <div class="cover-meta">
      <span class="cover-meta__tag">{{ '신규 기준선' if d.is_baseline else '직전 발행일 ' ~ d.previous_report.report_date_kst ~ ' 대비' }}</span>
      <span><span class="nw">{{ d.report_date_kst }} ({{ d.get('weekday_ko', '') }}) 기준</span> · 비교 기간 <span class="nw">{{ c.period_start }} ~ {{ c.period_end }}</span></span>
      <a class="cover-meta__link" href="report.pdf" download="{{ d.download_prefix }}.pdf">PDF ↓</a>
      <a class="cover-meta__link" href="#src-dl">PPTX · DATA</a>
    </div>
  </div>
  <div class="cover-art" aria-hidden="true">
    <div class="cover-art__issue">ISSUE {{ "%02d"|format(d.issue_no) }}<br>{{ d.report_date_kst | replace('-', '.') }}</div>
    <div class="cover-art__disc"></div>
    <div class="cover-art__ring"></div>
    <div class="cover-art__type">AI<br>TREND</div>
  </div>
</section>

{#- B형: 익스플레이너 카드 — 숫자로 본 이번 호 #}
<div class="explainer-grid" role="list" aria-label="숫자로 본 이번 호">
  {% for key, tg, label in [('new', '신규', '비교 기간에 새로 나온 것'), ('changed', '개선', '기능·가격·정책이 바뀐 것'), ('ended', '종료', '서비스·모델이 끝난 것'), ('watch', '관찰', '다음 호까지 지켜볼 것')] %}
  <div class="explainer-card" role="listitem">
    <div class="explainer-card__index">{{ "%02d"|format(loop.index) }} {{ tag(tg) }}</div>
    <h3>{{ c.status_counts.get(key, 0) }}<small>건</small></h3>
    <p>{{ label }}{% if key == 'new' and c.status_counts.get('corrected', 0) %} · 이 밖에 {{ tag('정정') }} {{ c.status_counts.corrected }}건{% endif %}</p>
  </div>
  {% endfor %}
</div>

{#- 3분 요약 (라임 안내 띠) #}
<section class="start-band" id="summary" aria-labelledby="summary-title">
  <div class="start-band__title">
    <div class="eyebrow">3분 요약</div>
    <h2 id="summary-title">이번 호는 다섯 가지 변화로 요약된다</h2>
    <p>바쁘면 이 다섯 줄만 읽어도 된다. 자세한 근거는 아래 표와 출처 탭에 있다.</p>
  </div>
  <ol class="start-list">
    {% for t in d.headline.three_min_summary %}
    <li><small>{{ "%02d"|format(loop.index) }}<span class="s-ico">{{ icon(d.headline.three_min_icons[loop.index0] if d.headline.three_min_icons|length > loop.index0 else 'sparkle') }}</span></small><b>{{ t }}</b></li>
    {% endfor %}
  </ol>
</section>

{#- 작성 기준 (근거 블록 — 밝은 파랑) #}
<section class="start-band basis-band" id="basis" aria-labelledby="basis-title">
  <div class="start-band__title">
    <div class="eyebrow">작성 기준 · 읽는 법</div>
    <h2 id="basis-title">언제, 무엇을 근거로 썼는지 먼저 밝힌다</h2>
    <p>모든 수치에는 출처와 확인일이 붙어 있다. 등급 설명과 전체 출처는 출처 탭에 있다.</p>
  </div>
  <div class="start-list">
    <div><small>기준일</small><b>{{ d.report_date_kst }} ({{ d.get('weekday_ko', '') }}) KST</b></div>
    <div><small>비교 기간</small><b>{{ c.period_start }} ~ {{ c.period_end }}{% if d.is_baseline %} <span class="muted">· 최근 30일</span>{% endif %}</b></div>
    <div><small>직전 발행일</small><b>{{ d.previous_report.report_date_kst or '없음 (이번 호가 신규 기준선)' }}</b></div>
    <div><small>작성 목적</small><b>{{ d.basis.purpose }}</b></div>
    <div><small>데이터 기준</small><b>{{ d.basis.data_basis }}</b></div>
    <div><small>조사 규모</small><b>검색 {{ d.search_count }}회 · 출처 {{ c.source_count }}개 <span class="muted">(A&nbsp;{{ c.grade_counts.A }} · B&nbsp;{{ c.grade_counts.B }} · C&nbsp;{{ c.grade_counts.C }})</span></b></div>
    <div><small>환율 기준</small><b>1달러 = {{ fmt_num(c.fx.get('usd_krw'), 1) }}원 <span class="muted">({{ c.fx.get('date', '') }}, {{ c.fx.get('source', '') }})</span></b></div>
    <div><small>태그 읽는 법</small><b class="row" style="font-weight:500">{% for k in TOKENS.tags %}{{ tag(k) }}{% endfor %}<span class="muted" style="font-size:14px">색과 함께 아이콘·글자로 구분</span></b></div>
  </div>
</section>

{{ toc([('summary', '3분 요약'), ('basis', '작성 기준'), ('top-changes', '가장 중요한 변화'), ('core-table', '핵심 변화 표'), ('timeline', '타임라인'), ('tracking', '추적 결과·변화 없음'), ('watch', '다음 호 추적 항목'), ('ledger', '확인 기준')]) }}

<section class="sec" id="top-changes">
  {{ sec_head(c, 'top') }}
  <div class="top-cards">
    {% for it in c.top %}
    <article class="card">
      <div class="row-between"><span class="rank">변화 {{ loop.index }}</span>{{ imp(it.importance) }}</div>
      <div class="row mt8">{{ tag(it.tag) }}{% if it.get('service') %}<span class="muted" style="font-size:15px">{{ it.service }}</span>{% endif %}</div>
      <h3>{{ it.title_ko }}</h3>
      <p>{{ it.summary_ko }}</p>
      <p class="why"><b>왜 중요한가</b> {{ it.why_it_matters_ko }}</p>
      <div class="card-foot">{{ src_links(it.sources, 3) }}</div>
    </article>
    {% endfor %}
  </div>
</section>

<section class="sec" id="core-table">
  {{ sec_head(c, 'core') }}
  <div class="tbl-wrap">
    <table class="tbl">
      <thead><tr><th style="width:11%">중요도·태그</th><th style="width:36%">무엇이 달라졌는가</th><th style="width:25%">초보자에게 왜 중요한가</th><th style="width:12%">영향 대상</th><th style="width:16%">근거</th></tr></thead>
      <tbody>
      {% for it in c.core %}
      <tr id="item-{{ it.id }}">
        <td>{{ imp(it.importance) }}<div class="mt8">{{ tag(it.tag) }}</div></td>
        <td><div class="t-title">{{ it.title_ko }}</div><div class="t-sub">{{ it.summary_ko }}</div><div class="t-sub">{{ it.date }}{% if it.get('region') %} · {{ it.region }}{% endif %}</div></td>
        <td>{{ it.why_it_matters_ko }}</td>
        <td>{{ it.get('audience', '') }}</td>
        <td>{{ src_links(it.sources, 3) }}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  <p class="src-line">{{ '신규 기준선: 비교 기간(' ~ c.period_start ~ '~' ~ c.period_end ~ ')에 발표된 변화만 실었다.' if d.is_baseline else '직전 발행일 ' ~ d.previous_report.report_date_kst ~ ' 대비 달라진 사실만 실었다.' }}</p>
</section>

<section class="sec" id="timeline">
  {{ sec_head(c, 'timeline') }}
  <figure class="figure">
    {{ svg_timeline(c.timeline, c.period_start, c.period_end, 'screen', 1400) }}
    <figcaption>
      <p class="cap"><b>이 그림으로 알 수 있는 것</b>{{ d.sections.timeline.get('caption', '') }}</p>
      <p class="src-line">출처 · 각 사건의 공식 발표·보도(핵심 변화 표의 근거 열) · 확인일 {{ d.report_date_kst }}</p>
    </figcaption>
  </figure>
</section>

<section class="sec" id="tracking">
  <div class="grid g2">
    <div class="card">
      <h3>직전 추적 항목 결과</h3>
      <p class="mt8 muted">{{ '최초 발행(신규 기준선)이므로 해당 없음. 이번 호의 추적 항목은 다음 발행에서 결과를 점검한다.' if d.is_baseline else '' }}</p>
    </div>
    <div class="card">
      <h3>변화가 없었던 항목</h3>
      <ul class="mt8">{% for u in d.unchanged %}<li>{{ u }}</li>{% endfor %}</ul>
    </div>
  </div>
</section>

<section class="sec" id="watch">
  {{ sec_head(c, 'watch') }}
  <div class="tbl-wrap">
    <table class="tbl">
      <thead><tr><th style="width:30%">추적 항목</th><th style="width:11%">구분</th><th style="width:39%">지켜볼 신호</th><th style="width:20%">근거</th></tr></thead>
      <tbody>
      {% for it in c.watch %}
      <tr><td><div class="t-title">{{ it.title_ko }}</div><div class="t-sub">{{ it.summary_ko }}</div></td>
        <td>{{ wtype(it.get('watch_type', '보도')) }}</td><td>{{ it.get('signal', it.why_it_matters_ko) }}</td><td>{{ src_links(it.sources, 2) }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  <p class="src-line">공식 예고 = 회사·기관이 직접 밝힌 일정(A) · 보도 = 신뢰 매체 보도(B) · 루머 = 확인되지 않은 관측(C). 이 목록은 다음 호 ‘직전 추적 항목 결과’의 입력이 된다.</p>
</section>

{#- C형: 이슈 레저 — 숫자·가격·정책·위험을 다룬 호의 확인 기준 (본문 마지막) #}
<section class="issue-ledger" id="ledger" aria-labelledby="ledger-title">
  <div class="issue-ledger__head">
    <div class="issue-ledger__intro">
      <div class="eyebrow">ISSUE LEDGER</div>
      <h2 id="ledger-title">이번 호에서 확인한 기준.</h2>
      <p>가격·출시 범위·위험을 다룬 호라서, 어떤 기준으로 확인했는지 따로 남긴다.</p>
    </div>
    <div class="issue-ledger__summary">
      <article class="ledger-stat">
        <div class="ledger-stat__label">RELEASE</div>
        <strong>출시일과 적용 범위를 나눠 적었다</strong>
        <p>발표일·지원 지역·요금제·실제 사용 가능 여부를 분리하고, 앱마다 적용일이 다르면 각각 표시했다.</p>
      </article>
      <article class="ledger-stat">
        <div class="ledger-stat__label">COST</div>
        <strong>가격 기준과 단위를 섞지 않았다</strong>
        <p>월 구독료(1달러 = {{ fmt_num(c.fx.get('usd_krw'), 1) }}원 환산)와 API 100만 토큰 단가를 따로 비교했다.</p>
      </article>
      <article class="ledger-stat">
        <div class="ledger-stat__label">RISK</div>
        <strong>사람의 승인 지점을 남긴다</strong>
        <p>AI 에이전트에 일을 맡길 때 권한·승인·기록을 먼저 정하라는 원칙을 사고 사례와 함께 적었다.</p>
      </article>
    </div>
  </div>
  <div class="ledger-checks">
    <div class="ledger-check"><span class="ledger-check__type">SOURCE</span><b>핵심 사실 {{ d.get('reverified', [])|length }}건은 공식 원문을 다시 열어 확인했다</b><span class="ledger-check__state">CHECKED</span></div>
    <div class="ledger-check"><span class="ledger-check__type">PRICE</span><b>요금 {{ d.metrics.get('prices', [])|length }}건·API {{ d.metrics.get('api_prices', [])|length }}건에 통화·기준일·요금제·부가세 여부를 적었다</b><span class="ledger-check__state">CHECKED</span></div>
    <div class="ledger-check"><span class="ledger-check__type">GRADE</span><b>결론·순위·가격 표의 수치는 공식 출처 1곳 또는 전문 매체 2곳 이상으로 확인했다</b><span class="ledger-check__state">CHECKED</span></div>
  </div>
</section>
{% endmacro %}

{# ═════════ 02 AI 서비스 ═════════ #}
{% macro panel_services(c) %}
{% set d = c.d %}
<section class="sec" id="svc-top">
  {{ sec_head(c, 'services', None, '02') }}
  {{ toc([('svc-table', '서비스 비교'), ('svc-media', '이미지·영상·음성'), ('svc-guide', '선택 가이드'), ('svc-perf', '성능 지표'), ('svc-cands', '목적별 후보군'), ('svc-users', '이용자별 선택'), ('svc-price', '요금'), ('svc-api', 'API 비용')]) }}
</section>

<section class="sec" id="svc-table">
  {{ sec_head(c, 'svc_table') }}
  <div class="tbl-wrap">
    <table class="tbl">
      <thead><tr><th style="width:14%">서비스 · 주력 모델</th><th style="width:19%">가장 잘하는 일</th><th style="width:18%">초보자 추천 상황</th><th style="width:19%">유의할 한계</th><th style="width:16%">무료/유료</th><th style="width:14%">직전 발행 대비</th></tr></thead>
      <tbody>
      {% for r in d.services %}
      <tr><td><div class="t-title">{{ r.service }}</div><div class="t-sub">{{ r.vendor }} · {{ r.flagship }}</div></td>
        <td>{{ r.best_at }}</td><td>{{ r.recommend_for }}</td><td>{{ r.limits }}</td><td>{{ r.free_paid }}</td>
        <td>{{ r.change }}<div class="mt8">{{ src_links(r.sources, 2, False) }}</div></td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>

<section class="sec" id="svc-media">
  {{ sec_head(c, 'media') }}
  <div class="tbl-wrap">
    <table class="tbl">
      <thead><tr><th style="width:8%">분야</th><th style="width:14%">서비스</th><th style="width:17%">최신 모델</th><th style="width:22%">강점</th><th style="width:22%">한계·주의</th><th style="width:17%">요금·상태</th></tr></thead>
      <tbody>
      {% for r in d.media_services %}
      <tr><td>{{ r.group }}</td><td><div class="t-title">{{ r.service }}</div><div class="t-sub">{{ r.vendor }}</div></td><td>{{ r.latest }}</td>
        <td>{{ r.strength }}</td><td>{{ r.limits }}</td><td>{% if r.status == '종료' %}{{ tag('종료') }} {% endif %}{{ r.price }}<div class="mt8">{{ src_links(r.sources, 2, False) }}</div></td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>

<section class="sec" id="svc-guide">
  {{ sec_head(c, 'guide') }}
  <div class="grid g3">
    {% for g in d.selection_guide %}
    <div class="card">
      <h3 class="row"><span class="area-ico" style="width:36px;height:36px;border-radius:10px;display:grid;place-items:center;background:var(--bg-elev-2);color:var(--teal)">{{ icon(g.icon) }}</span>{{ g.purpose }}</h3>
      <p class="mt16"><b>후보</b> {{ g.candidates | join(' · ') }}</p>
      <p class="why">{{ g.why }}</p>
      {% if g.get('caution') %}<div class="card-foot">유의: {{ g.caution }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
</section>

<section class="sec" id="svc-perf">
  {{ sec_head(c, 'perf') }}
  <div class="grid g2">
    {% for lb in d.metrics.leaderboards if lb.get('screen_chart', lb.get('print_chart')) %}
    <figure class="figure">
      <div class="row-between"><h3 class="card-title">{{ lb.name }}</h3><span class="muted" style="font-size:14px">{{ lb.purpose }} · {{ lb.version }}</span></div>
      <div class="mt16">{% if lb.chart == 'dot' %}{{ svg_dotplot(lb.rows[:lb.get('chart_n', 10)], 'screen', 680, lb.name) }}{% else %}{{ svg_bars(lb.bar_rows[:lb.get('chart_n', 10)], 'screen', 680, lb.get('unit', ''), lb.name) }}{% endif %}</div>
      <figcaption>
        <p class="cap"><b>읽는 법</b>{{ lb.easy }}</p>
        <p class="src-line">출처 · <a href="{{ lb.source_url }}" target="_blank" rel="noopener">{{ lb.publisher }}</a> ({{ lb.method }}) · 측정 {{ lb.checked_at }}{% if lb.get('analogy') %} · 비유: {{ lb.analogy }}{% endif %}</p>
      </figcaption>
    </figure>
    {% endfor %}
  </div>
  <div class="easy"><b>쉽게 말하면</b>{{ d.sections.perf.get('easy', '') }}</div>
  <h3 class="sub-title" id="svc-bench">{{ d.sections.bench.title }}</h3>
  <div class="tbl-wrap">
    <table class="tbl">
      <thead><tr><th style="width:17%">지표 (비유)</th><th style="width:10%">목적</th><th style="width:33%">상위권 (점수)</th><th style="width:15%">버전 · 측정일</th><th style="width:25%">해석 한계</th></tr></thead>
      <tbody>
      {% for lb in d.metrics.leaderboards %}
      <tr><td><div class="t-title">{{ lb.name }}</div><div class="t-sub">{{ lb.get('analogy', '') }}</div></td><td>{{ lb.purpose }}</td>
        <td>{% for r in lb.rows[:3] %}{{ r.rank }}. {{ r.model }} <span class="muted">({{ fmt_score(r.score) }}{{ ' ±' ~ r.ci_plus if r.get('ci_plus') else '' }})</span>{{ '' if loop.last else ' · ' }}{% endfor %}</td>
        <td>{{ lb.version }}<div class="t-sub">{{ lb.checked_at }} · {{ lb.method }}</div></td><td>{{ lb.note }}<div class="mt8"><a href="{{ lb.source_url }}" target="_blank" rel="noopener" style="font-size:14px">원 사이트</a></div></td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  <p class="src-line">개발사 자체 발표 점수는 섞지 않았다. 점수 차가 오차 범위(±) 안이면 순위를 단정하지 않고 동률권으로 본다.</p>
</section>

<section class="sec" id="svc-cands">
  {{ sec_head(c, 'candidates') }}
  <div class="tbl-wrap">
    <table class="tbl">
      <thead><tr><th style="width:14%">목적</th><th style="width:30%">최상위권 (동률권 포함)</th><th style="width:30%">상위권</th><th style="width:26%">근거 지표</th></tr></thead>
